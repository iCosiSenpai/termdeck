{
  "name": "termdeck",
  "version": "0.3.0",
  "description": "A cinematic theme deck and profile switcher for Ghostty and modern terminals.",
  "type": "module",
  "bin": {
    "termdeck": "./bin/termdeck.js"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check src/cli.js && node --check src/dashboard.js && node --check scripts/render-previews.js && node --test",
    "previews": "node scripts/render-previews.js",
    "start": "node ./bin/termdeck.js"
  },
  "keywords": [
    "ghostty",
    "terminal",
    "themes",
    "iterm2",
    "kitty",
    "wezterm",
    "alacritty"
  ],
  "author": "Alessio Cosi",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iCosiSenpai/termdeck.git"
  },
  "bugs": {
    "url": "https://github.com/iCosiSenpai/termdeck/issues"
  },
  "homepage": "https://github.com/iCosiSenpai/termdeck#readme",
  "files": [
    "bin",
    "src",
    "themes",
    "assets",
    "install.sh",
    "LICENSE",
    "README.md"
  ]
}
